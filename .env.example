# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public site origin as browsers see it (Cloudflare → Vercel proxy).
# Required in production so auth redirects stay on this host, not *.vercel.app.
# Example: https://thetitleresidence.com
NEXT_PUBLIC_SITE_URL=

# Early launch: set "true" so new registrations are active immediately (no admin queue)
# and pending members can sign in. Set "false" later to require /admin approval again.
# Also disable "Confirm email" in Supabase: Authentication → Providers → Email.
NEXT_PUBLIC_BYPASS_MEMBERSHIP_APPROVAL=true

# n8n webhook — welcome email when a member is approved (admin or auto on register)
N8N_MEMBER_APPROVED_WEBHOOK_URL=
# Optional override when URL has ?dev=1 (default: same URL with /webhook/ → /webhook-test/)
N8N_MEMBER_APPROVED_TEST_WEBHOOK_URL=
# n8n webhook — confirmation email after a member registers for an event
N8N_EVENT_CONFIRM_EMAIL_WEBHOOK_URL=
# Optional override when URL has ?dev=1 (default: same URL with /webhook/ → /webhook-test/)
N8N_EVENT_CONFIRM_EMAIL_TEST_WEBHOOK_URL=
# Optional: sent as Authorization: Bearer <secret>
# N8N_WEBHOOK_SECRET=
